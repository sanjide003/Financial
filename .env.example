# Firebase Web config values for deployment/build pipelines.
# The current static app reads js/firebase-config.js directly; keep dev/staging/prod
# Firebase projects separate and copy only the intended public web config there.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
